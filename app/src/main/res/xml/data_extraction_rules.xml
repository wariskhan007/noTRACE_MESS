<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicitly excludes ALL app data from Android's auto-backup and
    device-transfer mechanisms. NoTrace's identity keys, session state,
    and encrypted message database must never be included in a cloud or
    device-to-device backup (plan Section 6, Section 22 "Review backups").
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
